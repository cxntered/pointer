<Styles
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:components="using:pointer.Gui.Components"
    xmlns:local="using:pointer.Gui.Utils">

    <Style Selector="components|CheckBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="Transparent" Padding="{TemplateBinding Padding}">
                    <DockPanel>
                        <Border
                            Width="55"
                            Height="15"
                            VerticalAlignment="Center"
                            DockPanel.Dock="Right">
                            <Border
                                x:Name="PART_Nub"
                                Width="40"
                                Height="15"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="2.5"
                                CornerRadius="7.5" />
                        </Border>
                        <ContentPresenter
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}" />
                    </DockPanel>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="components|CheckBox:checked /template/ Border#PART_Nub">
        <Setter Property="Width" Value="55" />
        <Setter Property="BorderThickness" Value="0" />
        <Style.Animations>
            <Animation FillMode="Forward" Duration="0:0:0.2">
                <Animation.Easing>
                    <local:OutElasticHalf />
                </Animation.Easing>
                <KeyFrame Cue="100%">
                    <Setter Property="Width" Value="55" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="components|CheckBox:unchecked /template/ Border#PART_Nub">
        <Setter Property="Width" Value="40" />
        <Setter Property="BorderThickness" Value="2.5" />
        <Style.Animations>
            <Animation
                Easing="QuinticEaseOut"
                FillMode="Forward"
                Duration="0:0:0.2">
                <KeyFrame Cue="100%">
                    <Setter Property="Width" Value="40" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <Style Selector="components|CheckBox:disabled /template/ Border#PART_Nub">
        <Setter Property="Opacity" Value="0.3" />
    </Style>
</Styles>
